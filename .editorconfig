# root: nothing above this directory contributes, so a checkout under an unrelated tree is styled the same.
root = true

# Line endings are deliberately absent: .gitattributes normalizes them with `* text=auto`, so pinning one
# here would fight the native checkout rather than settle anything.
[*]
charset = utf-8
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.{md,yml,yaml,json,resx,csproj,props,targets,slnx}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in markdown.
trim_trailing_whitespace = false

[*.cs]

# CA1873: Avoid potentially expensive logging
dotnet_diagnostic.CA1873.severity = none

# Code style preference enforcement
dotnet_diagnostic.IDE0028.severity = warning
dotnet_diagnostic.IDE0029.severity = warning
dotnet_diagnostic.IDE0030.severity = warning
dotnet_diagnostic.IDE0031.severity = warning
dotnet_diagnostic.IDE0034.severity = warning
dotnet_diagnostic.IDE0035.severity = warning
dotnet_diagnostic.IDE0037.severity = warning
dotnet_diagnostic.IDE0038.severity = warning
dotnet_diagnostic.IDE0042.severity = warning
dotnet_diagnostic.IDE0043.severity = warning
dotnet_diagnostic.IDE0044.severity = warning
dotnet_diagnostic.IDE0050.severity = warning
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning
dotnet_diagnostic.IDE0056.severity = warning
dotnet_diagnostic.IDE0057.severity = warning
dotnet_diagnostic.IDE0059.severity = warning
dotnet_diagnostic.IDE0060.severity = warning
dotnet_diagnostic.IDE0063.severity = warning
dotnet_diagnostic.IDE0065.severity = warning
dotnet_diagnostic.IDE0070.severity = warning
dotnet_diagnostic.IDE0071.severity = warning
dotnet_diagnostic.IDE0075.severity = warning
dotnet_diagnostic.IDE0078.severity = warning
dotnet_diagnostic.IDE0079.severity = warning
dotnet_diagnostic.IDE0080.severity = warning
dotnet_diagnostic.IDE0090.severity = warning
dotnet_diagnostic.IDE0100.severity = warning
dotnet_diagnostic.IDE0110.severity = warning
dotnet_diagnostic.IDE0130.severity = warning
dotnet_diagnostic.IDE0150.severity = warning
dotnet_diagnostic.IDE0161.severity = warning
dotnet_diagnostic.IDE0170.severity = warning
dotnet_diagnostic.IDE0180.severity = warning
dotnet_diagnostic.IDE0200.severity = warning
dotnet_diagnostic.IDE0230.severity = warning
dotnet_diagnostic.IDE0240.severity = warning
dotnet_diagnostic.IDE0241.severity = warning
dotnet_diagnostic.IDE0250.severity = warning
dotnet_diagnostic.IDE0251.severity = warning
dotnet_diagnostic.IDE0260.severity = warning
dotnet_diagnostic.IDE0270.severity = warning
dotnet_diagnostic.IDE0280.severity = warning
dotnet_diagnostic.IDE0300.severity = warning
dotnet_diagnostic.IDE0301.severity = warning
dotnet_diagnostic.IDE0302.severity = warning
dotnet_diagnostic.IDE0303.severity = warning
dotnet_diagnostic.IDE0304.severity = warning
dotnet_diagnostic.IDE0305.severity = warning
dotnet_diagnostic.IDE0306.severity = warning
dotnet_diagnostic.IDE0330.severity = warning
dotnet_diagnostic.IDE0360.severity = warning
dotnet_diagnostic.IDE0380.severity = warning
dotnet_diagnostic.IDE0390.severity = warning
dotnet_diagnostic.IDE0391.severity = warning
dotnet_diagnostic.IDE2000.severity = warning
dotnet_diagnostic.IDE2001.severity = warning
dotnet_diagnostic.IDE2002.severity = warning
dotnet_diagnostic.IDE2005.severity = warning
dotnet_diagnostic.IDE2006.severity = warning

# CA2016: Forward the CancellationToken parameter - defaults to Info, which never
# surfaces in `dotnet build` output; promote so it's actually enforced.
dotnet_diagnostic.CA2016.severity = warning

# xUnit1051: use TestContext.Current.CancellationToken - already warning by default,
# pinned explicitly since it's now load-bearing for the build (see TreatWarningsAsErrors).
dotnet_diagnostic.xUnit1051.severity = warning

# SYSLIB1045: use [GeneratedRegex] over a Regex built at run time. Defaults to Info, which never surfaces
# in `dotnet build` output, so the rule was advice nothing enforced. Only fires where the generator is
# available, which leaves the netstandard2.0 halves alone.
dotnet_diagnostic.SYSLIB1045.severity = warning

# CA1865-CA1867: the char overload of StartsWith/EndsWith/IndexOf. Same story - Info by default.
dotnet_diagnostic.CA1865.severity = warning
dotnet_diagnostic.CA1866.severity = warning
dotnet_diagnostic.CA1867.severity = warning

# IDE0290: primary constructors off in src; test fixtures may use them.
csharp_style_prefer_primary_constructors = false

# All private fields use _camelCase, including static and const
dotnet_naming_rule.private_fields_should_be_underscore_camel.severity = suggestion
dotnet_naming_rule.private_fields_should_be_underscore_camel.symbols = private_fields
dotnet_naming_rule.private_fields_should_be_underscore_camel.style = underscore_camel_case

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

[tests/SimpleLocalizations.Benchmarks/**.cs]

# CA1822: Mark members as static - BenchmarkDotNet requires instance [Benchmark] methods,
# so acting on this suggestion would break the benchmarks.
dotnet_diagnostic.CA1822.severity = none
