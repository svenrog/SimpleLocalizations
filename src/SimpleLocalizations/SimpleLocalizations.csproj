<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0 rather than a current TFM: the analyzer half has no choice (a Roslyn component runs
         inside the compiler), and matching it here costs only the two range expressions ListFormatter would
         otherwise use. What it buys is a localization library reachable from .NET Framework, which is where
         a good deal of CMS work still lives. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>SimpleLocalizations</PackageId>
    <Description>Localized text whose identity is stored: a .resx generates the typed keys its producers name, and an analyzer keeps the vocabulary closed, so a key renamed in the resource moves its callers and no call site can invent one.</Description>
    <PackageTags>localization;resx;source-generator;analyzer;i18n</PackageTags>
    <!-- One package, two assemblies. A consumer references this and the generator attaches itself, because
         the targets below ship inside the package and a package's build/ is imported into every referencing
         project — which is what keeps the analyzer half unconditional while the generator's inputs stay
         conditioned on a resource existing. -->
    <DevelopmentDependency>false</DevelopmentDependency>
  </PropertyGroup>

  <ItemGroup>
    <!-- ReferenceOutputAssembly off: the generator is packed, never referenced. The reference is kept only
         for build ordering — the pack target below asks the project where its output is. -->
    <ProjectReference Include="../SimpleLocalizations.Generator/SimpleLocalizations.Generator.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="build/SimpleLocalizations.targets" Pack="true" PackagePath="build/" />
    <None Include="../../LICENSE.txt" Pack="true" PackagePath="/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- GetTargetPath rather than ResolveProjectReferences: it answers where the output is without invoking
       Build, which is what lets a pack with NoBuild set work at all — resolving the reference the ordinary
       way asks an already-built project to build again and fails with NETSDK1085. -->
  <Target Name="PackGeneratorAssembly" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="../SimpleLocalizations.Generator/SimpleLocalizations.Generator.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_GeneratorAssembly" />
    </MSBuild>

    <ItemGroup>
      <None Include="@(_GeneratorAssembly)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
  </Target>

</Project>
