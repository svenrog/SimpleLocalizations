<Project>

  <!-- A vocabulary is declared once, on its resource file, and reaches three places from there: the embedded
       resource the catalog reads at run time (the SDK's own globbing), the AdditionalFiles the generator
       reads at build time, and the metadata telling it which class and key type to emit. Metadata carries
       over from the source item, so the names a VocabularyResource declares are the ones the generator
       reads. -->
  <!-- Defaults, so `<VocabularyResource Include="Strings.resx" />` on its own is a whole declaration. Each is
       what the file already says: the class is named after it, the namespace and resource name follow the
       same RootNamespace + folder path the SDK gives the embedded resource, and the key type is the one this
       package ships for a project that keys a single kind of thing. Every one is overridable, and a project
       that keys more than one kind names its own types. -->
  <ItemGroup Condition="'@(VocabularyResource)' != ''">
    <VocabularyResource Update="@(VocabularyResource)">
      <VocabularyClass Condition="'%(VocabularyClass)' == ''">%(Filename)Keys</VocabularyClass>
      <VocabularyKeyType Condition="'%(VocabularyKeyType)' == ''">SimpleLocalizations.LocalizationKey</VocabularyKeyType>
      <_VocabularyFolder>$([System.String]::Copy('%(RelativeDir)').Replace('\', '.').Replace('/', '.'))</_VocabularyFolder>
    </VocabularyResource>
    <VocabularyResource Update="@(VocabularyResource)">
      <!-- TrimEnd: a resource at the project root contributes no folder, and `Ns.` is not a namespace. -->
      <VocabularyNamespace Condition="'%(VocabularyNamespace)' == ''">$([System.String]::Copy('$(RootNamespace).%(_VocabularyFolder)').TrimEnd('.'))</VocabularyNamespace>
      <VocabularyResourceName Condition="'%(VocabularyResourceName)' == ''">$(RootNamespace).%(_VocabularyFolder)%(Filename)</VocabularyResourceName>
    </VocabularyResource>
  </ItemGroup>

  <ItemGroup Condition="'@(VocabularyResource)' != ''">
    <AdditionalFiles Include="@(VocabularyResource)" />

    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="VocabularyClass" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="VocabularyKeyType" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="VocabularyNamespace" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="VocabularyDerived" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="VocabularyResourceName" />
  </ItemGroup>

  <!-- SL1009 has to be checked here rather than in the generator, because by the time the generator runs the
       evidence is gone: metadata reaches it through a generated .editorconfig, whose parser reads ';' as the
       start of a comment and drops the rest of the line. A declaration written with MSBuild's own list
       separator therefore arrives truncated to its first entry, generates the wrong key types, and compiles
       clean. MSBuild still holds the whole value.

       This is an MSBuild warning, not a compiler one, so `TreatWarningsAsErrors` does not reach it — a build
       that wants it fatal sets `MSBuildTreatWarningsAsErrors`. -->
  <Target Name="SimpleLocalizationsCheckMetadata"
          BeforeTargets="CoreCompile"
          Condition="'@(VocabularyResource)' != ''">
    <Warning Code="SL1009"
             Condition="$([System.String]::Copy('%(VocabularyResource.VocabularyKeyType)').Contains(';'))"
             Text="VocabularyKeyType on %(VocabularyResource.Identity) contains ';', which the generator never sees: separate entries with '|'." />
    <Warning Code="SL1009"
             Condition="$([System.String]::Copy('%(VocabularyResource.VocabularyDerived)').Contains(';'))"
             Text="VocabularyDerived on %(VocabularyResource.Identity) contains ';', which the generator never sees: separate entries with '|'." />
  </Target>

</Project>
